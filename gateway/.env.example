# Copy to gateway/.env and fill in (.env and keys/ are never committed)

# Key files of the Concordium testnet accounts (exported from the Browser Wallet), in gateway/keys/
FACILITATOR_KEY_FILE=keys/facilitator.export   # account that sponsors fees (needs test CCD)
BUYER_KEY_FILE=keys/buyer.export               # demo buyer (needs test CCD)
SELLER_ADDRESS=                                # payout address (your main account; address only)
# SELLER_KEY_FILE=keys/seller.export           # used once, to register the on-chain agentWallet (npm run registry -- set-wallet 1313)

# Secret shared with the Python API: put the same value in both .env files (any long random string)
GATEWAY_SECRET=

PRICE_MICROCCD=1000000        # 1 CCD
API_URL=http://127.0.0.1:8000
FACILITATOR_URL=http://localhost:4021
FACILITATOR_API_KEY=           # for Concordium's hosted testnet facilitator (https://x402-facilitator.testnet.concordium.com/); never commit it
FACILITATOR_AUTH_HEADER=       # default Authorization (Bearer added automatically); set if the service wants another header name
GATEWAY_URL=https://veriflow-yrhp.onrender.com   # buyer: the live testnet gateway; use http://localhost:4020 if you run your own
MAX_PAY_MICROCCD=2000000       # buyer guardrail: at most 2 CCD per payment
BUYER_AGENT_TOKEN_ID=          # optional: the buyer's own CIS-8004 agent token id; the seller checks the paying account is its agentWallet
BUYER_AGENT=optional           # seller policy: off / optional (check when named) / required (sell only to registered agents)
PLT_PRICE=                     # seller, optional: also accept a Protocol-Level Token, e.g. VFUSD:1000000 (1 VFUSD)
BUYER_PAY_ASSET=CCD            # buyer: pay in CCD or a PLT (e.g. VFUSD)
BUYER_MAX_PAY=2000000          # buyer: per-payment cap when paying in a PLT (the token's smallest unit)
# Cross-chain payment (USDC on Base Sepolia). Seller: payout EVM public key (create with npm run cis8 -- keygen seller, bind to #1313's owner with bind)
SELLER_EVM_PUBLIC_KEY=
EVM_PRICE_USD=0.01
FACILITATOR_EVM_URL=https://x402.org/facilitator
EVM_RPC_URL=                   # optional: for reading Base receipts (settlement-failure recovery); default https://sepolia.base.org
# Buyer: BUYER_PAY_NETWORK=evm pays in USDC (bind the key to the buyer's Concordium account first); BUYER_MAX_PAY in USDC's smallest unit, default 20000 = 0.02
BUYER_PAY_NETWORK=
BUYER_EVM_KEY_FILE=keys/evm-buyer.json
REQUIRE_SELLER_BADGE=true      # buyer guardrail: verify the seller before paying (badge, Registry, Agent Card hash, payTo = on-chain agentWallet)
# ANCHOR_KEY_FILE=keys/facilitator.export  # account that anchors signal hashes; defaults to the facilitator account

# ── Buyer eligibility (Verify & Access) ──
# Buyers prove eligibility in zero knowledge at /verify before paying; set to false to turn it off temporarily
REQUIRE_ELIGIBILITY=true
# The country of residence must not be on this list (ISO alpha-2, comma-separated). For a "refused" demo, temporarily add DK
RESTRICTED_COUNTRIES=US,KP,IR,CU,SY
# Public URL of the verification page (the 402 tells buyer agents where to verify)
PUBLIC_URL=http://localhost:4020
# ELIGIBILITY_FILE=data/eligibility.json
