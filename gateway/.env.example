# 複製成 gateway/.env 再填（.env 和 keys/ 都不會被 commit）

# 三個 Concordium testnet 帳號的私鑰檔（Browser Wallet 匯出），放在 gateway/keys/
FACILITATOR_KEY_FILE=keys/facilitator.export   # 代付手續費的帳號（需要測試 CCD）
BUYER_KEY_FILE=keys/buyer.export               # 示範買方（需要測試 CCD）
SELLER_ADDRESS=                                # 收款地址（你的主帳號，只要地址）

# 跟 Python API 共用的密鑰：兩邊的 .env 要填一樣的值（隨便一串長字串）
GATEWAY_SECRET=

PRICE_MICROCCD=1000000        # 1 CCD
API_URL=http://127.0.0.1:8000
FACILITATOR_URL=http://localhost:4021
GATEWAY_URL=http://localhost:4020
MAX_PAY_MICROCCD=2000000       # 買方護欄：單次最多付 2 CCD
# ANCHOR_KEY_FILE=keys/facilitator.export  # 寫訊號雜湊上鏈的帳號；不填就用 facilitator 帳號

# ── 買方資格驗證（Verify & Access）──
# 付款前要先在 /verify 用錢包做零知識證明；設成 false 可暫時關閉
REQUIRE_ELIGIBILITY=true
# 居住國不能在這份名單（ISO 兩碼，逗號分隔）。demo「被拒」時可以暫時加上 DK
RESTRICTED_COUNTRIES=US,KP,IR,CU,SY
# 驗證頁對外網址（402 回應裡會告訴買方 agent 去哪裡驗證）
PUBLIC_URL=http://localhost:4020
# ELIGIBILITY_FILE=data/eligibility.json
